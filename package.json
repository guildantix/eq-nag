{
  "name": "electron-angular-eq-parse",
  "version": "0.1.4",
  "main": "main.js",
  "scripts": {
    "copy-source-maps": "copyfiles --flat dist/*.map source-maps/%npm_package_version%",
    "tsc": "tsc",
    "ng": "ng",
    "start": "electron .",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "start:electron": "tsc && ng build --base-href ./ --configuration=production && electron .",
    "build": "npm run copy-source-maps && electron-builder build --win --publish never",
    "deploy": "npm run copy-source-maps && electron-builder build --win --publish always"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/schematics": "^11.2.19",
    "@angular/animations": "~11.2.14",
    "@angular/cdk": "^11.2.13",
    "@angular/common": "~11.2.14",
    "@angular/compiler": "~11.2.14",
    "@angular/core": "~11.2.14",
    "@angular/forms": "~11.2.14",
    "@angular/material": "^11.2.13",
    "@angular/platform-browser": "~11.2.14",
    "@angular/platform-browser-dynamic": "~11.2.14",
    "@angular/router": "~11.2.14",
    "@types/lodash-es": "^4.17.4",
    "archiver": "^5.3.0",
    "chokidar": "^3.4.0",
    "electron-log": "^4.4.1",
    "electron-unhandled": "^3.0.2",
    "electron-updater": "^4.3.1",
    "fuse.js": "^6.4.3",
    "handlebars": "^4.7.6",
    "lodash": "^4.17.15",
    "lodash-es": "^4.17.21",
    "nanoid": "^3.1.10",
    "ng-table-virtual-scroll": "^1.3.8",
    "ngx-electron": "^2.2.0",
    "rxjs": "~6.5.5",
    "tga2png": "^0.1.3",
    "tslib": "^2.0.0",
    "uuid": "^8.2.0",
    "xml2js": "^0.4.23",
    "zone.js": "~0.10.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1102.19",
    "@angular/cli": "~11.2.19",
    "@angular/compiler-cli": "~11.2.14",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.19.4",
    "codelyzer": "^6.0.0",
    "copyfiles": "^2.4.1",
    "electron": "^9.4.4",
    "electron-builder": "^22.7.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guildantix/eq-parse.git"
  },
  "build": {
    "productName": "EQ Nag",
    "appId": "scripter.eqNotificationAgent",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "publish": [
        {
          "provider": "github"
        }
      ],
      "icon": "Nag.ico"
    },
    "portable": {
      "artifactName": "eq_nag_portable.exe"
    },
    "directories": {
      "output": "electron/output",
      "buildResources": "electron/buildResources"
    }
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  }
}
