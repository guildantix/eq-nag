{
  "name": "electron-angular-eq-parse",
  "version": "0.1.30",
  "main": "main.js",
  "description": "An EverQuest Notification AGent",
  "author": {
    "name": "Guild Antix",
    "email": "srbmmo@gmail.com"
  },
  "scripts": {
    "copy-source-maps": "copyfiles --flat dist/*.map source-maps/%npm_package_version%",
    "tsc": "tsc",
    "ng": "ng",
    "start": "electron .",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "start:electron": "tsc && ng build --base-href ./ --configuration=production && electron .",
    "build": "npm run copy-source-maps && electron-builder build --win --publish never",
    "deploy": "npm run copy-source-maps && electron-builder build --win --publish always"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.1.1",
    "@angular/cdk": "^14.1.1",
    "@angular/common": "^14.1.1",
    "@angular/compiler": "^14.1.1",
    "@angular/core": "^14.1.1",
    "@angular/forms": "^14.1.1",
    "@angular/material": "^14.1.1",
    "@angular/platform-browser": "^14.1.1",
    "@angular/platform-browser-dynamic": "^14.1.1",
    "@angular/router": "^14.1.1",
    "@electron/remote": "^2.0.9",
    "@types/lodash-es": "^4.17.4",
    "adm-zip": "^0.5.10",
    "archiver": "^5.3.0",
    "chokidar": "^3.4.0",
    "cron-parser": "^4.8.1",
    "electron-log": "^5.0.0-beta.16",
    "electron-unhandled": "^4.0.1",
    "electron-updater": "^5.3.0",
    "fuse.js": "^6.4.3",
    "handlebars": "^4.7.6",
    "lodash": "^4.17.15",
    "lodash-es": "^4.17.21",
    "nanoid": "^3.1.10",
    "ng-table-virtual-scroll": "^1.4.1",
    "ngx-markdown": "^14.0.1",
    "ngx-mat-timepicker": "^14.0.8",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~6.5.5",
    "tga2png": "^0.1.3",
    "tslib": "^2.0.0",
    "xml2js": "^0.4.23",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.1.1",
    "@angular-devkit/schematics": "^14.1.1",
    "@angular/cli": "^14.1.1",
    "@angular/compiler-cli": "^14.1.1",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "codelyzer": "^6.0.0",
    "copyfiles": "^2.4.1",
    "electron": "^23.1.0",
    "electron-builder": "^23.6.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "^4.6.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guildantix/eq-parse.git"
  },
  "build": {
    "productName": "EQ Nag",
    "appId": "scripter.eqNotificationAgent",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "publish": [
        {
          "provider": "github"
        }
      ],
      "icon": "Nag.ico"
    },
    "portable": {
      "artifactName": "eq_nag_portable.exe"
    },
    "directories": {
      "output": "electron/output",
      "buildResources": "electron/buildResources"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!.angular",
      "!.vscode",
      "!e2e",
      "!source-maps",
      "package.json",
      "!tsconfig*",
      "!tslint*",
      "!readme*",
      "!angular.json",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  }
}
