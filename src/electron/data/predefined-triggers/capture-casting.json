{
    "triggerId": "CaptureSpellCast",
    "name": "Capture spell casting",
    "enabled": true,
    "capturePhrases": [
        {
            "ignoreCase": false,
            "useRegEx": true,
            "requirePreviousPhrase": false,
            "duration": null,
            "phrase": "^You (?:begin (?:cast|sing)ing|activate) (.*)\\.$",
            "phraseId": "PhraseForCasting"
        },
        {
            "ignoreCase": true,
            "useRegEx": true,
            "requirePreviousPhrase": false,
            "duration": null,
            "phraseId": "Phrase4Interrupt",
            "phrase": "^Your ${SpellBeingCast} spell (?:is interrupted|did not take hold|fizzles)"
        },
        {
            "ignoreCase": true,
            "useRegEx": true,
            "requirePreviousPhrase": false,
            "duration": null,
            "phraseId": "PhraseForResists",
            "phrase": "^(.{0,40}) resisted your ${SpellBeingCast}"
        },
        {
            "ignoreCase": true,
            "requirePreviousPhrase": false,
            "duration": null,
            "phraseId": "PhraseForReflect",
            "phrase": "^${Character}'s ${SpellBeingCast} spell has been reflected",
            "useRegEx": true
        }
    ],
    "comments": "This trigger will capture the spell casting of the caster and store the spell being cast into a variable for use with other triggers.",
    "actions": [
        {
            "actionType": 5,
            "variableName": "SpellBeingCast",
            "actionId": "ActStoreVarSpell",
            "phraseId": "PhraseForCasting",
            "phrases": [
                "PhraseForCasting"
            ],
            "restartBehavior": 0,
            "onlyExecuteInDev": false,
            "onlyStoreUsedValues": true,
            "variableStorageType": "localVariable"
        },
        {
            "actionType": 7,
            "phraseId": "Phrase4Interrupt",
            "overlayId": "gx4ySJU9Cj35xR1n",
            "duration": 15,
            "actionId": "ActClearVarSpell",
            "phrases": [
                "Phrase4Interrupt",
                "PhraseForResists",
                "PhraseForReflect"
            ],
            "variableName": "SpellBeingCast",
            "restartBehavior": 0,
            "onlyExecuteInDev": false,
            "variableStorageType": "localVariable"
        }
    ],
    "captureMethod": "Any match",
    "conditions": [],
    "classLevels": [],
    "predefined": true,
    "onlyExecuteInDev": false
}
